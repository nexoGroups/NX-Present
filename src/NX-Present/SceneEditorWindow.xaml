<Window x:Class="NXPresent.SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NXPresent"
        Title="Szenen-Editor (OBS-Modus) · NX-Present"
        Width="1440" Height="880" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource NxFont}" FontSize="12">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="52"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Top Bar -->
  <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
   <Grid VerticalAlignment="Center">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- Title & Scene Name -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="🎬" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock Text="SZENEN-EDITOR" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <TextBlock Text="Name:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox x:Name="SceneNameBox" Width="140" MinHeight="28" VerticalAlignment="Center" Text="Neue Szene" TextChanged="SceneNameChanged"/>
    </StackPanel>

    <!-- Template selector -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
     <TextBlock Text="Vorlage:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="TemplatePicker" Width="180" MinHeight="28" SelectionChanged="TemplateSelectionChanged">
      <ComboBoxItem Content="🎬 Kino Pre-Show (Countdown + Musik)" IsSelected="True"/>
      <ComboBoxItem Content="Pre-Show: Musik, Visualizer &amp; Uhr"/>
      <ComboBoxItem Content="Minimalistischer Song-Screen (ohne Uhr)"/>
      <ComboBoxItem Content="Broadcast Lower-Third (Bauchbinde)"/>
      <ComboBoxItem Content="Leere Szene"/>
     </ComboBox>
    </StackPanel>

    <!-- Target selector -->
    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
     <TextBlock Text="Zuweisen an:" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <ComboBox x:Name="TargetChannelPicker" Width="135" MinHeight="28">
      <ComboBoxItem Content="In Medienpool ablegen" IsSelected="True"/>
      <ComboBoxItem Content="AUX 1"/>
      <ComboBoxItem Content="AUX 2"/>
      <ComboBoxItem Content="AUX 3"/>
      <ComboBoxItem Content="AUX 4"/>
      <ComboBoxItem Content="AUX 5"/>
      <ComboBoxItem Content="AUX 6"/>
      <ComboBoxItem Content="AUX 7"/>
      <ComboBoxItem Content="AUX 8"/>
      <ComboBoxItem Content="AUX 9"/>
      <ComboBoxItem Content="AUX 10"/>
     </ComboBox>
    </StackPanel>

    <!-- Buttons -->
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="Abbrechen" Style="{StaticResource QuietButton}" MinHeight="28" Padding="14,4" Margin="0,0,8,0" IsCancel="True"/>
     <Button x:Name="SaveButton" Content="Übernehmen &amp; Speichern" Style="{StaticResource PrimaryButton}" MinHeight="28" Padding="16,4" Click="SaveClicked" IsDefault="True"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Main Work Area -->
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="380"/>
   </Grid.ColumnDefinitions>

   <!-- Left: 16:9 Canvas Work Area -->
   <Border Background="{StaticResource Inset}" Padding="16">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <!-- Aspect Ratio Letterboxed Canvas (Virtual 1920x1080) -->
     <local:AspectBox HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border x:Name="CanvasHost" Background="Black" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
       <!-- SceneCanvasView is inserted here in code-behind -->
      </Border>
     </local:AspectBox>

     <!-- Bottom Canvas Helper Bar -->
     <Border Grid.Row="1" Background="{StaticResource Chrome}" CornerRadius="4" Margin="0,8,0,0" Padding="10,6">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="💡" Margin="0,0,6,0"/>
       <TextBlock Text="Ebene auf der Leinwand anklicken zum Verschieben. Anfasser ziehen zum Skalieren. Pfeiltasten = 1 px, Umschalt+Pfeil = 10 px, Entf = Löschen." Style="{StaticResource Hint}" FontSize="11"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <!-- Right: OBS-style Sources & Properties Panel -->
   <Border Grid.Column="1" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="14">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="180"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <!-- Sources Header & Add Toolbar -->
     <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="QUELLEN &amp; EBENEN" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="AddSourceButton" Content="+ Quelle" Style="{StaticResource PrimaryButton}" MinHeight="24" Padding="10,2" Click="OpenAddSourceMenu">
        <Button.ContextMenu>
         <ContextMenu>
          <MenuItem Header="🎵 Musik / Song-Anzeige (Now Playing)" Click="AddSongSource"/>
          <MenuItem Header="📊 Audio-Visualizer (Equalizer / Welle / Kreis)" Click="AddVisualizerSource"/>
          <MenuItem Header="⏰ Uhrzeit &amp; Datum" Click="AddClockSource"/>
          <MenuItem Header="🕒 Countdown / Vorstellungs-Timer" Click="AddCountdownSource"/>
          <MenuItem Header="🪟 Anwendungsfenster erfassen" Click="AddWindowSource"/>
          <MenuItem Header="🖼️ Bild- oder Videodatei" Click="AddMediaSource"/>
          <MenuItem Header="🔤 Textfeld" Click="AddTextSource"/>
          <MenuItem Header="⬛ Farbfläche / Kachel" Click="AddColorBoxSource"/>
         </ContextMenu>
        </Button.ContextMenu>
       </Button>
       <Button Content="▲" Style="{StaticResource QuietButton}" Width="26" MinHeight="24" Padding="0" Margin="4,0,0,0" ToolTip="Nach oben verschieben" Click="MoveUpClicked"/>
       <Button Content="▼" Style="{StaticResource QuietButton}" Width="26" MinHeight="24" Padding="0" Margin="2,0,0,0" ToolTip="Nach unten verschieben" Click="MoveDownClicked"/>
       <Button Content="📋" Style="{StaticResource QuietButton}" Width="26" MinHeight="24" Padding="0" Margin="2,0,0,0" ToolTip="Ebene duplizieren" Click="DuplicateClicked"/>
       <Button Content="🗑" Style="{StaticResource QuietButton}" Width="26" MinHeight="24" Padding="0" Margin="2,0,0,0" ToolTip="Ebene entfernen" Click="DeleteClicked"/>
      </StackPanel>
     </Grid>

     <!-- Sources ListBox -->
     <ListBox x:Name="LayersList" Grid.Row="1" Background="{StaticResource Inset}" BorderBrush="{StaticResource Line}" BorderThickness="1"
              SelectionChanged="LayersSelectionChanged">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid Margin="4,2">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <!-- Eye Visibility Toggle -->
         <CheckBox IsChecked="{Binding Visible, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Sichtbar" Click="LayerVisibilityChanged"/>
         <!-- Type Icon -->
         <TextBlock Grid.Column="1" Text="❖" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         <!-- Name -->
         <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>

     <!-- Properties Header -->
     <TextBlock Grid.Row="2" Text="EIGENSCHAFTEN DER AUSWAHL" Style="{StaticResource SectionTitle}" Margin="0,14,0,8"/>

     <!-- Properties Scroll Area -->
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PropertiesPanel" Margin="0,0,4,0">
       <TextBlock x:Name="NoSelectionHint" Text="Wähle eine Ebene aus oder füge mit '+ Quelle' eine neue hinzu." Style="{StaticResource Hint}" Margin="0,12"/>

       <!-- Common Transform Group -->
       <Border x:Name="TransformGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Position &amp; Größe (1920×1080)" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="X" Style="{StaticResource Hint}"/><TextBox x:Name="PropXBox" TextChanged="PropTransformChanged"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Y" Style="{StaticResource Hint}"/><TextBox x:Name="PropYBox" TextChanged="PropTransformChanged"/></StackPanel>
         </Grid>
         <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Breite" Style="{StaticResource Hint}"/><TextBox x:Name="PropWBox" TextChanged="PropTransformChanged"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Höhe" Style="{StaticResource Hint}"/><TextBox x:Name="PropHBox" TextChanged="PropTransformChanged"/></StackPanel>
         </Grid>
         <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
          <TextBlock Text="Deckkraft:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Hint}"/>
          <Slider x:Name="PropOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" ValueChanged="PropOpacityChanged"/>
          <TextBlock Grid.Column="2" x:Name="PropOpacityLabel" Text="100%" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
         </Grid>
        </StackPanel>
       </Border>

       <!-- Specific: Song Properties -->
       <Border x:Name="SongGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Song- &amp; Musik-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <CheckBox x:Name="SongAutoMediaBox" Content="Automatisch von Windows Media lesen" IsChecked="True" Checked="SongPropChanged" Unchecked="SongPropChanged" Margin="0,0,0,8"/>
         <TextBlock Text="(Liest Spotify, Browser/YouTube, VLC etc. automatisch aus)" Style="{StaticResource Hint}" Margin="0,0,0,8"/>

         <StackPanel x:Name="SongManualInputs" Margin="0,0,0,8">
          <TextBlock Text="Eigener Titel:" Style="{StaticResource Hint}"/>
          <TextBox x:Name="SongTitleBox" Margin="0,2,0,6" TextChanged="SongPropChanged"/>
          <TextBlock Text="Interpret:" Style="{StaticResource Hint}"/>
          <TextBox x:Name="SongArtistBox" Margin="0,2,0,6" TextChanged="SongPropChanged"/>
          <TextBlock Text="Album:" Style="{StaticResource Hint}"/>
          <TextBox x:Name="SongAlbumBox" Margin="0,2,0,6" TextChanged="SongPropChanged"/>
         </StackPanel>

         <CheckBox x:Name="SongShowCoverBox" Content="Album-Cover anzeigen" IsChecked="True" Checked="SongPropChanged" Unchecked="SongPropChanged" Margin="0,0,0,8"/>
         <TextBlock Text="Cover-Stil:" Style="{StaticResource Hint}"/>
         <ComboBox x:Name="SongCoverStylePicker" Margin="0,2,0,8" SelectionChanged="SongPropChanged">
          <ComboBoxItem Content="Abgerundetes Quadrat" IsSelected="True"/>
          <ComboBoxItem Content="Scharfes Quadrat"/>
          <ComboBoxItem Content="Vinyl-Schallplatte (drehend)"/>
         </ComboBox>

         <TextBlock Text="Schriftgröße:" Style="{StaticResource Hint}"/>
         <Slider x:Name="SongFontSizeSlider" Minimum="14" Maximum="64" Value="28" ValueChanged="SongPropChanged" Margin="0,2,0,8"/>
        </StackPanel>
       </Border>

       <!-- Specific: Visualizer Properties -->
       <Border x:Name="VizGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Visualizer-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <TextBlock Text="Stil:" Style="{StaticResource Hint}"/>
         <ComboBox x:Name="VizStylePicker" Margin="0,2,0,8" SelectionChanged="VizPropChanged">
          <ComboBoxItem Content="Frequenz-Balken (Equalizer)" IsSelected="True"/>
          <ComboBoxItem Content="Audiowelle (Oszilloskop)"/>
          <ComboBoxItem Content="Kreis-Visualizer"/>
          <ComboBoxItem Content="Partikel &amp; Ambient Glow"/>
         </ComboBox>

         <TextBlock Text="Farbschema:" Style="{StaticResource Hint}"/>
         <ComboBox x:Name="VizThemePicker" Margin="0,2,0,8" SelectionChanged="VizPropChanged">
          <ComboBoxItem Content="Neon Cyan / Magenta" IsSelected="True"/>
          <ComboBoxItem Content="Electric Blue"/>
          <ComboBoxItem Content="Amber Fire"/>
          <ComboBoxItem Content="Rainbow"/>
          <ComboBoxItem Content="Clean White"/>
          <ComboBoxItem Content="Emerald Green"/>
         </ComboBox>

         <TextBlock Text="Balkenanzahl:" Style="{StaticResource Hint}"/>
         <Slider x:Name="VizBarCountSlider" Minimum="12" Maximum="64" Value="36" ValueChanged="VizPropChanged" Margin="0,2,0,8"/>

         <TextBlock Text="Empfindlichkeit (Gain):" Style="{StaticResource Hint}"/>
         <Slider x:Name="VizSensSlider" Minimum="0.5" Maximum="3.0" Value="1.2" ValueChanged="VizPropChanged" Margin="0,2,0,8"/>
        </StackPanel>
       </Border>

       <!-- Specific: Clock Properties -->
       <Border x:Name="ClockGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Uhrzeit-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <CheckBox x:Name="ClockSecondsBox" Content="Sekunden anzeigen (:ss)" Checked="ClockPropChanged" Unchecked="ClockPropChanged" Margin="0,0,0,6"/>
         <CheckBox x:Name="ClockDateBox" Content="Datum anzeigen (z.B. Mittwoch, 11. Nov)" Checked="ClockPropChanged" Unchecked="ClockPropChanged" Margin="0,0,0,8"/>
         <TextBlock Text="Schriftgröße:" Style="{StaticResource Hint}"/>
         <Slider x:Name="ClockFontSizeSlider" Minimum="20" Maximum="100" Value="48" ValueChanged="ClockPropChanged" Margin="0,2,0,8"/>
        </StackPanel>
       </Border>

       <!-- Specific: Countdown Properties -->
       <Border x:Name="CountdownGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Countdown- &amp; Timer-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton x:Name="CountdownModeTargetRadio" Content="Ziel-Uhrzeit" GroupName="CdModeGroup" IsChecked="True" Checked="CountdownPropChanged" Margin="0,0,12,0"/>
          <RadioButton x:Name="CountdownModeDurationRadio" Content="Dauer" GroupName="CdModeGroup" Checked="CountdownPropChanged"/>
         </StackPanel>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="Ziel-Uhrzeit (HH:mm)" Style="{StaticResource Hint}"/>
           <TextBox x:Name="CountdownTargetBox" Text="20:00" TextChanged="CountdownPropChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="Dauer in Sek." Style="{StaticResource Hint}"/>
           <TextBox x:Name="CountdownDurationBox" Text="900" TextChanged="CountdownPropChanged"/>
          </StackPanel>
         </Grid>
         <TextBlock Text="Einleitungstext:" Style="{StaticResource Hint}" Margin="0,0,0,2"/>
         <TextBox x:Name="CountdownPrefixBox" Text="Die Vorstellung beginnt in" TextChanged="CountdownPropChanged" Margin="0,0,0,8"/>
         <CheckBox x:Name="CountdownShowPrefixBox" Content="Einleitung anzeigen" IsChecked="True" Checked="CountdownPropChanged" Unchecked="CountdownPropChanged" Margin="0,0,0,8"/>
         <TextBlock Text="Text bei Ablauf (00:00):" Style="{StaticResource Hint}" Margin="0,0,0,2"/>
         <TextBox x:Name="CountdownExpiredBox" Text="Die Vorstellung beginnt gleich …" TextChanged="CountdownPropChanged" Margin="0,0,0,8"/>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="Schriftgröße" Style="{StaticResource Hint}"/>
           <TextBox x:Name="CountdownFontBox" Text="72" TextChanged="CountdownPropChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="Farbe (Hex)" Style="{StaticResource Hint}"/>
           <TextBox x:Name="CountdownColorBox" Text="#38BDF8" TextChanged="CountdownPropChanged"/>
          </StackPanel>
         </Grid>
         <CheckBox x:Name="CountdownTriggerCueBox" Content="Bei 00:00 nächsten Cue starten (Auto-GO)" IsChecked="True" Checked="CountdownPropChanged" Unchecked="CountdownPropChanged" Margin="0,4,0,0" ToolTip="Löst bei Ablauf des Countdowns automatisch den nächsten Schritt im Cue-Ablauf aus"/>
        </StackPanel>
       </Border>

       <!-- Specific: Text Properties -->
       <Border x:Name="TextGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Text-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <TextBlock Text="Textinhalt:" Style="{StaticResource Hint}"/>
         <TextBox x:Name="TextContentBox" MinHeight="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,8" TextChanged="TextPropChanged"/>
         <CheckBox x:Name="TextBoldBox" Content="Fett (Bold)" IsChecked="True" Checked="TextPropChanged" Unchecked="TextPropChanged" Margin="0,0,0,8"/>
         <TextBlock Text="Schriftgröße:" Style="{StaticResource Hint}"/>
         <Slider x:Name="TextFontSizeSlider" Minimum="12" Maximum="96" Value="32" ValueChanged="TextPropChanged" Margin="0,2,0,8"/>
        </StackPanel>
       </Border>

       <!-- Specific: ColorBox Properties -->
       <Border x:Name="ColorBoxGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Farbflächen-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <TextBlock Text="Farbe (Hex):" Style="{StaticResource Hint}"/>
         <TextBox x:Name="ColorBoxHexBox" Margin="0,2,0,8" Text="#131929" TextChanged="ColorBoxPropChanged"/>
         <TextBlock Text="Eckenabrundung:" Style="{StaticResource Hint}"/>
         <Slider x:Name="ColorBoxRadiusSlider" Minimum="0" Maximum="40" Value="12" ValueChanged="ColorBoxPropChanged" Margin="0,2,0,8"/>
        </StackPanel>
       </Border>

       <!-- Specific: WindowCapture Properties -->
       <Border x:Name="WinCaptureGroup" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Fenster-Optionen" FontWeight="SemiBold" Margin="0,0,0,8"/>
         <Button Content="Anwendungsfenster wählen …" Style="{StaticResource PrimaryButton}" Click="PickWindowForLayer" Margin="0,0,0,8"/>
         <TextBlock x:Name="WinSelectedLabel" Text="Kein Fenster gewählt." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>

      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
