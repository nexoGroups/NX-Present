<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- High-contrast industrial studio palette with crisp technical borders and functional accents -->
 <SolidColorBrush x:Key="Bg" Color="#0B0C0E"/>
 <SolidColorBrush x:Key="Chrome" Color="#111317"/>
 <SolidColorBrush x:Key="Panel" Color="#15181F"/>
 <SolidColorBrush x:Key="Elevated" Color="#1C2029"/>
 <SolidColorBrush x:Key="Raised" Color="#232733"/>
 <SolidColorBrush x:Key="RaisedHover" Color="#2D3342"/>
 <SolidColorBrush x:Key="RaisedPressed" Color="#181B23"/>
 <SolidColorBrush x:Key="SegmentThumb" Color="#444C5E"/>
 <SolidColorBrush x:Key="Inset" Color="#07080A"/>
 <SolidColorBrush x:Key="Line" Color="#242833"/>
 <SolidColorBrush x:Key="LineStrong" Color="#383E4F"/>
 <SolidColorBrush x:Key="Ink" Color="#F3F4F6"/>
 <SolidColorBrush x:Key="Muted" Color="#9CA3AF"/>
 <SolidColorBrush x:Key="Dim" Color="#5A6275"/>
 <SolidColorBrush x:Key="Accent" Color="#0077FF"/>
 <SolidColorBrush x:Key="AccentHover" Color="#298DFF"/>
 <SolidColorBrush x:Key="AccentPressed" Color="#005ECC"/>
 <SolidColorBrush x:Key="AccentText" Color="#4CA0FF"/>
 <SolidColorBrush x:Key="OnAccent" Color="#ffffff"/>
 <SolidColorBrush x:Key="Program" Color="#ff453a"/>
 <SolidColorBrush x:Key="Preview" Color="#32d74b"/>
 <SolidColorBrush x:Key="Danger" Color="#ff453a"/>
 <SolidColorBrush x:Key="Cap" Color="#2A2F3D"/>
 <SolidColorBrush x:Key="CapHover" Color="#383F52"/>
 <SolidColorBrush x:Key="CapBorder" Color="#4A536B"/>
 <!-- Tinted backgrounds for the video mixer tally and selection -->
 <SolidColorBrush x:Key="AccentDark" Color="#10223A"/>
 <SolidColorBrush x:Key="ProgramDark" Color="#3B1414"/>
 <SolidColorBrush x:Key="PreviewDark" Color="#0E2B18"/>
 <!-- Industrial studio functional accents -->
 <SolidColorBrush x:Key="IndustrialAmber" Color="#F59E0B"/>
 <SolidColorBrush x:Key="IndustrialCyan" Color="#06B6D4"/>
 <SolidColorBrush x:Key="IndustrialSteel" Color="#334155"/>
 <SolidColorBrush x:Key="IndustrialGrip" Color="#475569"/>
 <FontFamily x:Key="NxFont">/NX-Present;component/Assets/Fonts/#Inter</FontFamily>
 <FontFamily x:Key="NxMono">Consolas</FontFamily>
 <!-- Refined technical 2-3px corner radii (sharp industrial look) -->
 <CornerRadius x:Key="NxCardRadius">3</CornerRadius>
 <CornerRadius x:Key="NxControlRadius">2</CornerRadius>
 <CornerRadius x:Key="NxSmallRadius">2</CornerRadius>
</ResourceDictionary>
