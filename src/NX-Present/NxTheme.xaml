<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- WPF resources from NX-UI-System/tokens/nx-ui.tokens.json (dark palette and mouse sizing). -->
 <SolidColorBrush x:Key="Bg" Color="#0f1012"/>
 <SolidColorBrush x:Key="Chrome" Color="#16171a"/>
 <SolidColorBrush x:Key="Panel" Color="#1b1c20"/>
 <SolidColorBrush x:Key="Elevated" Color="#26282d"/>
 <SolidColorBrush x:Key="Raised" Color="#2c2e34"/>
 <SolidColorBrush x:Key="RaisedHover" Color="#35383f"/>
 <SolidColorBrush x:Key="RaisedPressed" Color="#3f424a"/>
 <SolidColorBrush x:Key="SegmentThumb" Color="#4a4d55"/>
 <SolidColorBrush x:Key="Inset" Color="#0b0c0e"/>
 <SolidColorBrush x:Key="Line" Color="#2b2d32"/>
 <SolidColorBrush x:Key="LineStrong" Color="#3b3e45"/>
 <SolidColorBrush x:Key="Ink" Color="#f2f3f5"/>
 <SolidColorBrush x:Key="Muted" Color="#a4a8b0"/>
 <SolidColorBrush x:Key="Dim" Color="#6b7079"/>
 <SolidColorBrush x:Key="Accent" Color="#006fff"/>
 <SolidColorBrush x:Key="AccentHover" Color="#2e89ff"/>
 <SolidColorBrush x:Key="AccentPressed" Color="#005bd1"/>
 <SolidColorBrush x:Key="AccentText" Color="#4c9dff"/>
 <SolidColorBrush x:Key="OnAccent" Color="#ffffff"/>
 <SolidColorBrush x:Key="Program" Color="#ff453a"/>
 <SolidColorBrush x:Key="Preview" Color="#32d74b"/>
 <SolidColorBrush x:Key="Danger" Color="#ff453a"/>
 <SolidColorBrush x:Key="Cap" Color="#3a3d44"/>
 <SolidColorBrush x:Key="CapHover" Color="#464951"/>
 <SolidColorBrush x:Key="CapBorder" Color="#52565f"/>
 <!-- Tinted backgrounds for the video mixer tally and selection. -->
 <SolidColorBrush x:Key="AccentDark" Color="#182e50"/>
 <SolidColorBrush x:Key="ProgramDark" Color="#461e1e"/>
 <SolidColorBrush x:Key="PreviewDark" Color="#163c20"/>
 <FontFamily x:Key="NxFont">/NX-Present;component/Assets/Fonts/#Inter</FontFamily>
 <CornerRadius x:Key="NxCardRadius">10</CornerRadius>
 <CornerRadius x:Key="NxControlRadius">6</CornerRadius>
 <CornerRadius x:Key="NxSmallRadius">4</CornerRadius>
</ResourceDictionary>
