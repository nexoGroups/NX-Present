<Window x:Class="NXPresent.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NXPresent" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="NX-Present · Bildmischer" Width="1600" Height="960" MinWidth="1180" MinHeight="740"
 WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource NxFont}" FontSize="12" UseLayoutRounding="True"
 AllowDrop="True" Drop="FilesDropped" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="ShowWhenChecked"/>

  <!-- Industrial Horizontal Resize Grip Template -->
  <ControlTemplate x:Key="HorizontalGripTemplate" TargetType="Thumb">
   <Border x:Name="GripBar" Background="Transparent" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Rectangle Width="20" Height="2" Fill="{StaticResource IndustrialSteel}" Margin="2,0" RadiusX="1" RadiusY="1"/>
     <Rectangle Width="20" Height="2" Fill="{StaticResource IndustrialSteel}" Margin="2,0" RadiusX="1" RadiusY="1"/>
     <Rectangle Width="20" Height="2" Fill="{StaticResource IndustrialSteel}" Margin="2,0" RadiusX="1" RadiusY="1"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="GripBar" Property="Background" Value="#2206B6D4"/>
    </Trigger>
    <Trigger Property="IsDragging" Value="True">
     <Setter TargetName="GripBar" Property="Background" Value="#4406B6D4"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Industrial Vertical Resize Grip Template -->
  <ControlTemplate x:Key="VerticalGripTemplate" TargetType="Thumb">
   <Border x:Name="GripBar" Background="Transparent" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Rectangle Width="2" Height="20" Fill="{StaticResource IndustrialSteel}" Margin="0,2" RadiusX="1" RadiusY="1"/>
     <Rectangle Width="2" Height="20" Fill="{StaticResource IndustrialSteel}" Margin="0,2" RadiusX="1" RadiusY="1"/>
     <Rectangle Width="2" Height="20" Fill="{StaticResource IndustrialSteel}" Margin="0,2" RadiusX="1" RadiusY="1"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter TargetName="GripBar" Property="Background" Value="#2206B6D4"/>
    </Trigger>
    <Trigger Property="IsDragging" Value="True">
     <Setter TargetName="GripBar" Property="Background" Value="#4406B6D4"/>
    </Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- A card in the media pool. -->
  <Style x:Key="PoolCard" TargetType="Button">
   <Setter Property="Focusable" Value="False"/><Setter Property="Width" Value="108"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="2">
    <StackPanel>
     <Grid Height="52" Margin="0,0,0,0" Background="{StaticResource Inset}">
      <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasThumbnail}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <TextBlock Text="{Binding Name}" Margin="7,5,7,0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Category}" Margin="7,1,7,6" Style="{StaticResource Eyebrow}" FontSize="9"/>
    </StackPanel></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger>
     <DataTrigger Binding="{Binding IsPreview}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Preview}"/></DataTrigger>
     <DataTrigger Binding="{Binding IsProgram}" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Program}"/></DataTrigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- AUX Output Channel Card (Top area of ATEM-style AUX Patcher) -->
  <Style x:Key="AuxOutputCard" TargetType="Button">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Width" Value="142"/>
   <Setter Property="Height" Value="118"/>
   <Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="2">
       <Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="66"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 16:9 Live Preview Thumbnail -->
        <Grid Background="{StaticResource Inset}" ClipToBounds="True">
         <Image Source="{Binding Source.Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
         <TextBlock Text="{Binding Source.Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Dim}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Style.Triggers>
             <DataTrigger Binding="{Binding Source.HasThumbnail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <!-- Active Target Badge -->
         <Border x:Name="TargetBadge" Background="{StaticResource Accent}" CornerRadius="2" Padding="5,1" Margin="4"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
          <TextBlock Text="ZIEL" Foreground="White" FontWeight="Bold" FontSize="8"/>
         </Border>
        </Grid>
        <!-- Output Channel Info -->
        <Border Grid.Row="1" Background="{StaticResource Chrome}" Padding="7,4,7,4">
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Source.Name}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Border>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
       </Trigger>
       <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter TargetName="Frame" Property="Background" Value="{StaticResource AccentDark}"/>
        <Setter TargetName="TargetBadge" Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Signal Source Card (Bottom area of ATEM-style AUX Patcher) -->
  <Style x:Key="AuxSourceCard" TargetType="Button">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="Width" Value="136"/>
   <Setter Property="Height" Value="114"/>
   <Setter Property="Margin" Value="0,0,8,8"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="2" CornerRadius="2">
       <Grid>
        <Grid.RowDefinitions>
         <RowDefinition Height="64"/>
         <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 16:9 Thumbnail -->
        <Grid Background="{StaticResource Inset}" ClipToBounds="True">
         <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
         <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Dim}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasThumbnail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <!-- Tally Badges -->
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
          <Border x:Name="PgmBadge" Background="{StaticResource Program}" CornerRadius="2" Padding="4,1" Margin="0,0,3,0" Visibility="Collapsed">
           <TextBlock Text="PGM" Foreground="White" FontWeight="Bold" FontSize="8"/>
          </Border>
          <Border x:Name="PvwBadge" Background="{StaticResource Preview}" CornerRadius="2" Padding="4,1" Visibility="Collapsed">
           <TextBlock Text="PVW" Foreground="Black" FontWeight="Bold" FontSize="8"/>
          </Border>
         </StackPanel>
         <!-- Routed Indicator -->
         <Border x:Name="RoutedBadge" Background="{StaticResource Accent}" CornerRadius="2" Padding="4,1" Margin="4"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
          <TextBlock Text="GEROUTET" Foreground="White" FontWeight="Bold" FontSize="8"/>
         </Border>
        </Grid>
        <!-- Source Info -->
        <Border Grid.Row="1" Background="{StaticResource Chrome}" Padding="7,3,7,3">
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Category}" Style="{StaticResource Eyebrow}" FontSize="8" Margin="0,0,0,1" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Border>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
       </Trigger>
       <DataTrigger Binding="{Binding IsProgram}" Value="True">
        <Setter TargetName="PgmBadge" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Program}"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsPreview}" Value="True">
        <Setter TargetName="PvwBadge" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Preview}"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsRouted}" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter TargetName="Frame" Property="Background" Value="{StaticResource AccentDark}"/>
        <Setter TargetName="RoutedBadge" Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="26"/><RowDefinition Height="44"/></Grid.RowDefinitions>

  <!-- Title bar. WindowChrome keeps native move, resize and snap. -->
  <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="14,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="NX" Foreground="{StaticResource Accent}" FontWeight="Black" FontStyle="Italic" FontSize="17"/>
     <TextBlock Text="PRESENT" FontWeight="SemiBold" FontSize="11" Margin="7,2,0,0" VerticalAlignment="Center"/>
     <Border Style="{StaticResource IndustrialBadge}" Margin="16,0,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="PageTitle" Text="Mischer" Style="{StaticResource Eyebrow}" FontFamily="{StaticResource NxMono}" FontSize="10" Foreground="{StaticResource Ink}"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <ToggleButton x:Name="LayoutEditToggle" Content="📐 Layout" Visibility="{Binding Visibility, ElementName=MixerPage}" Margin="0,4,8,4" MinHeight="26" Padding="10,3" Focusable="False" ToolTip="Bearbeitungsmodus: Containergröße anpassen und skalieren" Checked="LayoutEditToggle_Click" Unchecked="LayoutEditToggle_Click" Click="LayoutEditToggle_Click"/>
     <ToggleButton x:Name="InspectorToggle" Content="Optionen" Visibility="{Binding Visibility, ElementName=MixerPage}" Margin="0,4,8,4" MinHeight="26" Padding="10,3" Focusable="False" ToolTip="Audio, Bild und Optionen für das inaktive ME"/>
     <Button x:Name="OutputToggleButton" Content="Ausgabe starten" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" MinHeight="26" Padding="10,3" Focusable="False" Click="ToggleOutput"/>
     <Button Click="OpenSettingsPage" Style="{StaticResource QuietButton}" MinHeight="0" Padding="10,0" Margin="0,0,10,0" ToolTip="Ausgabe und Geräte einrichten" Focusable="False"><StackPanel Orientation="Horizontal"><Ellipse x:Name="OutputDot" Width="7" Height="7" Fill="{StaticResource Dim}" Margin="0,0,7,0"/><TextBlock x:Name="OutputBadge" Text="AUSGABE AUS" FontFamily="Consolas" FontSize="11"/></StackPanel></Button>
     <TextBlock x:Name="ControlClock" Text="00:00:00" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0"/>
     <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Width="44" MinHeight="0" Padding="0" Focusable="False" ToolTip="Minimieren" AutomationProperties.Name="Minimieren" Click="MinimizeWindow"/>
     <Button x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Width="44" MinHeight="0" Padding="0" Focusable="False" ToolTip="Maximieren / Wiederherstellen" AutomationProperties.Name="Maximieren" Click="MaximizeWindow"/>
     <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource QuietButton}" Width="48" MinHeight="0" Padding="0" Focusable="False" ToolTip="Programm beenden" AutomationProperties.Name="Programm beenden" Click="ExitProgram"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1">
   <!-- ============ MIXER (NORMAL MODUS - OHNE MEDIENPOOL) ============ -->
   <Grid x:Name="MixerPage" Margin="12,12,12,8" Background="Transparent" MouseDown="MixerBackground_MouseDown">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="238"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <!-- Layout Edit Banner (visible when IsLayoutEditMode is True) -->
     <Border x:Name="LayoutEditBanner" Margin="0,0,0,8" Padding="10,6"
             Background="{StaticResource Chrome}" BorderBrush="{StaticResource IndustrialCyan}" BorderThickness="1" CornerRadius="2">
      <Border.Style>
       <Style TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding Path=IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Border.Style>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource IndustrialCyan}" CornerRadius="2" Padding="6,2" Margin="0,0,10,0">
         <TextBlock Text="LAYOUT-MODUS" Foreground="Black" FontWeight="Bold" FontSize="10" FontFamily="{StaticResource NxMono}"/>
        </Border>
        <TextBlock Text="Container skalieren (↕ AUX-Module, ↔ Optionen) oder Voreinstellungen wählen:"
                   Foreground="{StaticResource Ink}" FontSize="11" VerticalAlignment="Center"/>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="AUX-HÖHE:" Style="{StaticResource Eyebrow}" FontFamily="{StaticResource NxMono}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Content="S · 42px" Click="SetAuxSmall_Click" MinHeight="24" Padding="8,2" Margin="0,0,4,0" ToolTip="Standardhöhe (42 px)"/>
        <Button Content="M · 70px" Click="SetAuxMedium_Click" MinHeight="24" Padding="8,2" Margin="0,0,4,0" ToolTip="Mittlere Höhe (70 px)"/>
        <Button Content="L · 100px" Click="SetAuxLarge_Click" MinHeight="24" Padding="8,2" Margin="0,0,10,0" ToolTip="Große Höhe (100 px)"/>
        <Button Content="↺ Standard" Click="ResetLayout_Click" MinHeight="24" Padding="10,2" Margin="0,0,8,0" ToolTip="Layout auf Werkseinstellung zurücksetzen"/>
        <Button Content="✓ Fertig" Style="{StaticResource PrimaryButton}" Click="FinishLayoutEdit_Click" MinHeight="24" Padding="12,2" ToolTip="Layout sichern und Modus beenden"/>
       </StackPanel>
      </Grid>
     </Border>

     <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <local:MonitorView x:Name="Me1Monitor" Mode="Me1" Heading="ME1"/>
      <local:MonitorView x:Name="Me2Monitor" Grid.Column="2" Mode="Me2" Heading="ME2"/>
     </Grid>

     <!-- Transition controls stay together between the monitors and source buses. -->
     <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,0,0,8" Padding="12,6">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="150"/>
        <ColumnDefinition Width="44"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <ComboBox x:Name="TransitionPicker" Width="146" MinHeight="32" VerticalAlignment="Center" Focusable="False"
                 ToolTip="Übergangsart" AutomationProperties.Name="Übergangsart"/>
       <ComboBox x:Name="DurationPicker" Grid.Column="1" Width="84" MinHeight="32" VerticalAlignment="Center"
                 Margin="6,0,8,0" Focusable="False" ToolTip="Dauer des automatischen Übergangs" AutomationProperties.Name="Dauer des Übergangs"/>
       <local:TBar x:Name="TransitionBar" Grid.Column="2" VerticalAlignment="Center"
                   ToolTip="Von Hand überblenden" AutomationProperties.Name="Überblender"/>
       <TextBlock x:Name="TBarReadout" Grid.Column="3" Text="0 %" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CutButton" Content="CUT" Width="96" MinHeight="32" Focusable="False" FontWeight="SemiBold"
                Click="CutClicked" ToolTip="Sofortschnitt (Eingabetaste)" AutomationProperties.Name="Cut"/>
        <Button x:Name="AutoButton" Width="96" MinHeight="32" Margin="6,0,0,0" Padding="0" Focusable="False"
                Click="AutoClicked" ToolTip="Automatisch überblenden (Leertaste)" AutomationProperties.Name="Auto">
         <Grid Width="96" Height="32">
          <Border x:Name="AutoFill" HorizontalAlignment="Left" Width="0" Background="{StaticResource ProgramDark}" CornerRadius="{StaticResource NxControlRadius}"/>
          <TextBlock Text="AUTO" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
        </Button>
       </StackPanel>
       <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <ToggleButton x:Name="FtbButton" Content="FTB" Padding="10,3" Focusable="False" Click="FtbClicked"
                      ToolTip="Weich nach Schwarz blenden (F)" AutomationProperties.Name="Fade to Black"/>
        <ToggleButton x:Name="BlackMuteButton" Content="Schwarz + stumm" Padding="10,3" Margin="6,0,0,0" FontSize="11"
                      Focusable="False" Click="BlackMuteClicked" ToolTip="Sofort schwarz und stumm (Strg + B)" AutomationProperties.Name="Schwarz und stumm"/>
       </StackPanel>
      </Grid>
     </Border>

     <!-- AUX channels strip in normal mode with resize handle -->
     <Grid Grid.Row="3">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- Industrial Horizontal Resize Grip Thumb -->
      <Thumb x:Name="AuxResizeThumb" Height="8" Margin="0,0,0,2" Cursor="SizeNS"
             DragDelta="AuxResizeThumb_DragDelta" Template="{StaticResource HorizontalGripTemplate}"
             ToolTip="Ziehen: AUX-Modulhöhe anpassen"/>
      <Border Grid.Row="1" x:Name="AuxContainerBorder" Padding="8,7">
       <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding Path=IsLayoutEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
           <Setter Property="BorderBrush" Value="{StaticResource IndustrialCyan}"/>
           <Setter Property="BorderThickness" Value="1"/>
           <Setter Property="Background" Value="#0A06B6D4"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <ItemsControl x:Name="AuxTiles" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Button Margin="3,0" Padding="0" Click="AuxClicked" AutomationProperties.Name="{Binding Name}" MinWidth="0"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                  ToolTip="{Binding Source.ThumbnailError, TargetNullValue='Ins inaktive ME laden'}">
           <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
             <RowDefinition Height="{Binding Path=CurrentAuxThumbnailHeight, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
             <RowDefinition Height="Auto"/>
             <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="Black">
             <TextBlock Text="{Binding Source.Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Dim}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
               <Style TargetType="TextBlock">
                <Style.Triggers><DataTrigger Binding="{Binding Source.HasThumbnail}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
             <Image Source="{Binding Source.Thumbnail}" Stretch="Uniform"/>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Name}" FontFamily="{StaticResource NxMono}" FontWeight="SemiBold" FontSize="11" Margin="5,3,5,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2" Text="{Binding Source.Name}" Foreground="{StaticResource Muted}" FontSize="10" Margin="5,1,5,3" TextTrimming="CharacterEllipsis"/>
           </Grid>
          </Button>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </Border>
     </Grid>
    </Grid>

    <!-- Vertical Splitter Grip for Inspector -->
    <Thumb x:Name="InspectorResizeThumb" Grid.Column="1" Width="8" Margin="8,0,0,0" Cursor="SizeWE"
           DragDelta="InspectorResizeThumb_DragDelta" Template="{StaticResource VerticalGripTemplate}"
           ToolTip="Ziehen: Options-Breite anpassen"
           Visibility="{Binding Visibility, ElementName=InspectorPanel}"/>

    <!-- Inspector -->
    <ScrollViewer x:Name="InspectorPanel" Grid.Column="2"
                  Width="{Binding Path=InspectorPanelWidth, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                  Margin="4,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  Visibility="{Binding IsChecked, ElementName=InspectorToggle, Converter={StaticResource ShowWhenChecked}}">
     <StackPanel Margin="0,0,0,2">
      <Border Style="{StaticResource PanelBorder}" Padding="14,12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="AUSGABE" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="OutputDetail" Style="{StaticResource Hint}" FontSize="11" Margin="0" Text="Wähle unter Setup den Beamer."/>
      </StackPanel></Border>
      <Border Style="{StaticResource PanelBorder}" Padding="14,12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="AUDIO" Style="{StaticResource SectionTitle}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" Focusable="False" ToolTip="Hauptlautstärke für Videos" AutomationProperties.Name="Hauptlautstärke"/><TextBlock Grid.Column="1" x:Name="VolumeReadout" Text="80 %" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="RepeatVideo" Content="Videos wiederholen" Margin="0" VerticalAlignment="Center" Focusable="False" Checked="PlaybackOptionsChanged" Unchecked="PlaybackOptionsChanged"/><ToggleButton x:Name="MuteToggle" Grid.Column="1" Content="STUMM" FontSize="10" MinHeight="24" Padding="10,2" Focusable="False" Checked="PlaybackOptionsChanged" Unchecked="PlaybackOptionsChanged" ToolTip="Ton stummschalten (M)"/></Grid>
       <TextBlock Text="Webseiten haben ihre eigene Lautstärke; ihr Ton schaltet bei Übergängen um." Style="{StaticResource Hint}" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource PanelBorder}" Padding="14,12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="BILD" Style="{StaticResource SectionTitle}"/>
       <ComboBox x:Name="FitPicker" SelectedIndex="0" SelectionChanged="FitChanged" Focusable="False" ToolTip="Wie Bilder und Videos auf die Fläche passen"><ComboBoxItem Content="Einpassen (mit Rändern)"/><ComboBoxItem Content="Füllen (beschneiden)"/><ComboBoxItem Content="Strecken"/></ComboBox>
       <CheckBox x:Name="PatternMotion" Content="Testbilder animieren" IsChecked="True" Margin="0,10,0,0" Focusable="False" Checked="PatternAnimationChanged" Unchecked="PatternAnimationChanged"/>
      </StackPanel></Border>
      <Border Style="{StaticResource PanelBorder}" Padding="14,12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="QUELLE IM INAKTIVEN ME" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="InfoName" Text="—" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="InfoDetail" Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
       <Button x:Name="ReloadButton" Content="Webseite neu laden" Margin="0,10,0,0" Focusable="False" Click="ReloadClicked" Visibility="Collapsed"/>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>

   <!-- ============ AUX-PATCHER (ATEM SOFTWARE CONTROL) ============ -->
   <Grid x:Name="AuxPage" Visibility="Collapsed" Margin="12,12,12,8">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- OBERER BEREICH: AUX-AUSGÄNGE -->
    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8" Padding="14,10">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header row -->
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="AUX-AUSGÄNGE" Style="{StaticResource SectionTitle}" Margin="0,0,8,0"/>
        <Border Background="{StaticResource Raised}" CornerRadius="2" Padding="6,2" VerticalAlignment="Center">
         <TextBlock x:Name="AuxOutputsCount" Text="10 KANÄLE" Style="{StaticResource Eyebrow}" FontSize="9"/>
        </Border>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="Klicke auf einen AUX-Kanal, um ihn für das Routing auszuwählen." Style="{StaticResource Hint}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
       <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2" Padding="10,3" VerticalAlignment="Center">
         <TextBlock x:Name="SelectedAuxTargetHeader" Text="Aktives Routing-Ziel: AUX 1" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentText}"/>
        </Border>
        <Button Content="🎬 OBS-Szeneneditor" Style="{StaticResource PrimaryButton}" MinHeight="26" Padding="10,2" Margin="8,0,0,0" Click="EditCurrentAuxScene" ToolTip="Öffnet den OBS-Szeneneditor für den ausgewählten AUX-Kanal"/>
       </StackPanel>
      </Grid>

      <!-- AUX Channel Tiles -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Focusable="False">
       <ItemsControl x:Name="AuxOutputs" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Button Style="{StaticResource AuxOutputCard}" Click="AuxPatcherChannelClicked" AutomationProperties.Name="{Binding Name}"
                  ToolTip="{Binding Source.Name, StringFormat={}Kanal {0} · Klicke zum Auswählen}">
           <Button.ContextMenu>
            <ContextMenu>
             <MenuItem Header="Ins inaktive ME laden" Click="AuxOutputPreviewClicked"/>
             <MenuItem Header="Direkt übernehmen (CUT)" Click="AuxOutputCutClicked"/>
              <Separator/>
              <MenuItem Header="🎬 Im OBS-Szeneneditor bearbeiten …" Click="AuxOutputEditSceneClicked"/>
            </ContextMenu>
           </Button.ContextMenu>
          </Button>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </Grid>
    </Border>

    <!-- UNTERER BEREICH: NORMALE SIGNALQUELLEN -->
    <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="14,10">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Source selection header & controls -->
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="SIGNALQUELLEN" Style="{StaticResource SectionTitle}" Margin="0,0,8,0"/>
        <TextBlock x:Name="AuxSourceCount" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,14,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton x:Name="AuxAllSourcesFilter" Content="Alle" GroupName="AuxSourceFilter" Tag="all" Style="{StaticResource FilterButton}" IsChecked="True" Checked="AuxSourceFilterChanged"/>
        <RadioButton Content="Kameras &amp; Eingänge" GroupName="AuxSourceFilter" Tag="capture" Style="{StaticResource FilterButton}" Checked="AuxSourceFilterChanged"/>
        <RadioButton Content="Anwendungen" GroupName="AuxSourceFilter" Tag="windows" Style="{StaticResource FilterButton}" Checked="AuxSourceFilterChanged"/>
        <RadioButton Content="Medien" GroupName="AuxSourceFilter" Tag="media" Style="{StaticResource FilterButton}" Checked="AuxSourceFilterChanged"/>
        <RadioButton Content="Szenen" GroupName="AuxSourceFilter" Tag="scenes" Style="{StaticResource FilterButton}" Checked="AuxSourceFilterChanged"/>
        <RadioButton Content="Cue-Show" GroupName="AuxSourceFilter" Tag="cueshow" Style="{StaticResource FilterButton}" Checked="AuxSourceFilterChanged"/>
        <RadioButton Content="Testbilder" GroupName="AuxSourceFilter" Tag="patterns" Style="{StaticResource FilterButton}" Checked="AuxSourceFilterChanged"/>
       </StackPanel>

       <!-- Selected target readout -->
       <TextBlock Grid.Column="2" x:Name="SelectedAuxTargetLabel" Text="Zuweisung für: AUX 1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentText}"/>

       <!-- Search box -->
       <Grid Grid.Column="3" Width="190" Margin="0,0,10,0">
        <TextBox x:Name="AuxSourceSearch" MinHeight="26" Padding="26,3,8,3" TextChanged="AuxSourceSearchChanged" ToolTip="Signalquellen durchsuchen" AutomationProperties.Name="Quellen durchsuchen"/>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
        <TextBlock Text="Suchen …" Margin="27,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Dim}" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AuxSourceSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>

       <!-- Capture refresh -->
       <Button x:Name="RefreshCaptureButton" Grid.Column="4" Content="Eingänge &amp; Fenster neu erkennen" MinHeight="26" Padding="10,3" Click="RefreshCaptureClicked" Margin="0,0,8,0"/>
       <TextBlock x:Name="CaptureSummary" Grid.Column="5" Style="{StaticResource Hint}" VerticalAlignment="Center" FontSize="11"/>
      </Grid>

      <!-- Source Tiles Grid -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <Grid>
        <ItemsControl x:Name="AuxSources" Focusable="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Button Style="{StaticResource AuxSourceCard}" Click="AuxPatcherSourceClicked" AutomationProperties.Name="{Binding Name}"
                   ToolTip="{Binding Name, StringFormat={}Klick weist diese Quelle dem ausgewählten AUX-Kanal zu: {0}}"/>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyAuxSources" Text="Keine passenden Signalquellen gefunden." Style="{StaticResource Hint}" Margin="8,24" Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>

   <!-- ============ MEDIENPOOL (SEPARATER MODUS) ============ -->
   <Grid x:Name="PoolPage" Visibility="Collapsed" Margin="12,12,12,8">
    <Border Style="{StaticResource PanelBorder}" Padding="16,14">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- Top bar -->
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="Medienpool" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock x:Name="PoolCount" Grid.Column="1" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton x:Name="AllFilter" Content="Alle" GroupName="PoolFilter" Tag="all" Style="{StaticResource FilterButton}" IsChecked="True" Checked="PoolFilterChanged"/>
        <RadioButton Content="Medien" GroupName="PoolFilter" Tag="media" Style="{StaticResource FilterButton}" Checked="PoolFilterChanged"/>
        <RadioButton Content="Testbilder" GroupName="PoolFilter" Tag="patterns" Style="{StaticResource FilterButton}" Checked="PoolFilterChanged"/>
       </StackPanel>
       <Grid Grid.Column="4" Width="220" Margin="0,0,10,0">
        <TextBox x:Name="PoolSearch" MinHeight="28" Padding="26,4,8,4" TextChanged="PoolSearchChanged" ToolTip="Medienpool durchsuchen" AutomationProperties.Name="Pool durchsuchen"/>
        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
        <TextBlock Text="Suchen …" Margin="27,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Dim}" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PoolSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <Button x:Name="AddContentButton" Grid.Column="5" Content="+ Hinzufügen" Style="{StaticResource PrimaryButton}" MinHeight="28" Padding="14,4" Focusable="False" Click="OpenAddMenu">
        <Button.ContextMenu>
         <ContextMenu>
          <MenuItem Header="Bilder / Videos hinzufügen …" Click="AddFiles"/>
          <MenuItem Header="Anwendung / Fenster erfassen …" Click="AddWindowCapture"/>
          <MenuItem Header="Webseite hinzufügen …" Click="AddWebsite"/>
          <MenuItem Header="Text hinzufügen …" Click="AddText"/>
          <Separator/>
          <MenuItem Header="Uhr hinzufügen" Click="AddClock"/>
         </ContextMenu>
        </Button.ContextMenu>
       </Button>
      </Grid>
      <!-- Cards Grid -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
       <Grid>
        <ItemsControl x:Name="PoolItems" Focusable="False">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Button Style="{StaticResource PoolCard}" Click="PoolCardClicked" ToolTip="{Binding Name}">
            <Button.ContextMenu>
             <ContextMenu>
              <MenuItem Header="Ins inaktive ME laden" Click="PoolPreviewClicked"/>
              <MenuItem Header="Direkt übernehmen (CUT)" Click="PoolCutClicked"/>
              <Separator/>
              <MenuItem Header="Aus dem Pool entfernen" Click="PoolRemoveClicked"/>
             </ContextMenu>
            </Button.ContextMenu>
           </Button>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyPool" Text="Keine passenden Inhalte.&#x0a;Ziehe Dateien hierher oder nutze + Hinzufügen." Style="{StaticResource Hint}" Margin="8,24" Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>

   <local:CueModeView x:Name="CueModePage" Visibility="Collapsed" Margin="12,12,12,8"/>

   <!-- ============ SETUP ============ -->
   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,12,12,8">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,12,4">
     <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="Leinwand und Ausgabeschutz" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ausgabe-Bildschirm" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="DisplayPicker" Grid.Column="1" MinWidth="300"/><Button Grid.Column="2" Content="Neu erkennen" Click="RefreshDisplays" Margin="10,0,0,0"/></Grid>
      <StackPanel Margin="180,12,0,0">
       <CheckBox x:Name="Protection" Content="Maus und andere Fenster von der Leinwand fernhalten" IsChecked="True" Checked="ProtectionChanged" Unchecked="ProtectionChanged"/>
       <CheckBox x:Name="AutoStartOutput" Content="Beim Programmstart die Ausgabe mit Schwarzbild einschalten" IsChecked="True"/>
       <WrapPanel Margin="0,12,0,0"><Button x:Name="StartOutputButton" Content="Ausgabe starten" Click="StartOutput" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="StopOutputButton" Content="Ausgabe schließen" Click="StopOutput" IsEnabled="False"/></WrapPanel>
       <TextBlock Text="Globaler Notausstieg: Strg + Alt + F10 gibt Bildschirm und Maus frei. Auch ohne Ausgabe zeigen ME1 und ME2 ihre Quellen." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
      </StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="Audiogerät" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Audiogerät" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="AudioPicker" Grid.Column="1" MinWidth="300"/><Button Grid.Column="2" Content="Ton anwenden" Click="ApplyAudio" Margin="10,0,0,0"/></Grid>
      <StackPanel Margin="180,10,0,0"><TextBlock Text="Ändert das Windows-Standardgerät für Videos, Webseiten und andere Programme. Beim Beenden wird die vorherige Auswahl wiederhergestellt." Style="{StaticResource Hint}"/><Button Content="Audiogeräte neu erkennen" Click="RefreshAudio" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0,8" Margin="0,2,0,0"/></StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="Schwarzblende" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Dauer von FTB" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="FtbPicker" Grid.Column="1" Width="120" SelectionChanged="FtbDurationChanged"><ComboBoxItem Content="Sofort" Tag="0"/><ComboBoxItem Content="0,5 s" Tag="500"/><ComboBoxItem Content="1 s" Tag="1000"/><ComboBoxItem Content="2 s" Tag="2000"/><ComboBoxItem Content="3 s" Tag="3000"/></ComboBox></Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource PanelBorder}" Padding="22" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="Updates" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Installierte Version" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UpdateVersionText" Grid.Column="1" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center"/></Grid>
      <StackPanel Margin="180,12,0,0">
       <TextBlock x:Name="UpdateStatusText" Text="Noch nicht nach Updates gesucht." Style="{StaticResource Hint}"/>
       <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed" BorderThickness="0" Background="{StaticResource Line}" Foreground="{StaticResource Accent}"/>
       <WrapPanel Margin="0,12,0,0">
        <Button x:Name="CheckUpdateButton" Content="Nach Updates suchen" Click="CheckUpdateClicked" Margin="0,0,8,8"/>
        <Button x:Name="InstallUpdateButton" Content="Jetzt aktualisieren" Click="InstallUpdateClicked" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Visibility="Collapsed"/>
        <Button x:Name="UpdateNotesButton" Content="Versionshinweise" Click="UpdateNotesClicked" Margin="0,0,8,8" Visibility="Collapsed"/>
       </WrapPanel>
       <CheckBox x:Name="CheckUpdatesAtStart" Content="Beim Start nach Updates suchen" IsChecked="True" Margin="0,4,0,0"/>
       <CheckBox x:Name="AutoInstallUpdates" Content="Gefundene Updates beim Start automatisch installieren, solange nichts live ist" IsChecked="True"/>
       <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Quelle ist ausschließlich die offizielle GitHub-Veröffentlichungsseite von NX-Present. Das Setup wird gegen die dort veröffentlichte SHA-256-Prüfsumme geprüft, ist aber nicht signiert. Zum Aktualisieren wird NX-Present beendet und danach neu gestartet. Eine selbst gebaute Kopie wird nicht überschrieben."/>
      </StackPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource PanelBorder}" Padding="22"><StackPanel>
      <TextBlock Text="Sitzung und Dateien" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="Einstellungen und Medienpool werden automatisch gespeichert. Eine Showdatei sichert Pool und Cue-Ablauf zusätzlich separat." Style="{StaticResource Hint}" Margin="0,0,0,14"/>
      <WrapPanel><Button Content="Show öffnen …" Click="OpenShow" Margin="0,0,8,8"/><Button Content="Show speichern …" Click="SaveShow" Margin="0,0,8,8"/><Button Content="Hilfe und Tastenkürzel" Click="ShowHelp" Margin="0,0,8,8"/><Button Content="Programm beenden" Click="ExitProgram" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/></WrapPanel>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>

   <!-- ============ HELP ============ -->
   <ScrollViewer x:Name="HelpPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,12,12,8">
    <StackPanel MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,12,4">
     <Border Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="SO ARBEITET DER MISCHER" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/>
      <TextBlock Text="Quelle wählen und zwischen ME1 und ME2 wechseln" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,14"/>
      <TextBlock Style="{StaticResource Hint}" Text="ME1 und ME2 bleiben an ihrem Platz. Wähle eine AUX-Kachel oder eine Quelle aus dem Medienpool, um sie ins inaktive ME zu laden. Welche Quelle auf welchem AUX liegt, legst du im AUX-Patcher fest."/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="CUT, AUTO und der Überblender wechseln die Projektion zum anderen ME. Die rote Markierung zeigt das gewählte ME. Ein Video startet mit der Übernahme."/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="FTB blendet weich nach Schwarz und wieder zurück, auch der Ton. SCHWARZ + STUMM wirkt sofort."/>
     </StackPanel></Border>
     <Border Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="TASTENKÜRZEL" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <TextBlock Text="Leertaste, Strg + Enter" FontFamily="Consolas" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Grid.Column="1" Text="AUTO (auf der Cue-Seite: GO)" Style="{StaticResource Hint}"/>
       <TextBlock Grid.Row="1" Text="Eingabetaste" FontFamily="Consolas" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="CUT" Style="{StaticResource Hint}"/>
       <TextBlock Grid.Row="2" Text="1 bis 9, 0" FontFamily="Consolas" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="AUX 1 bis 9 bzw. AUX 10 ins inaktive ME laden" Style="{StaticResource Hint}"/>
       <TextBlock Grid.Row="3" Text="F" FontFamily="Consolas" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Fade to Black ein / aus" Style="{StaticResource Hint}"/>
       <TextBlock Grid.Row="4" Text="Strg + B" FontFamily="Consolas" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Schwarz + stumm (sofort)" Style="{StaticResource Hint}"/>
       <TextBlock Grid.Row="5" Text="M" FontFamily="Consolas" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Ton stumm" Style="{StaticResource Hint}"/>
       <TextBlock Grid.Row="6" Text="Strg + Alt + F10" FontFamily="Consolas" Foreground="{StaticResource Accent}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="Notausstieg: schließt die Ausgabe und gibt die Maus frei (global)" Style="{StaticResource Hint}"/>
      </Grid>
     </StackPanel></Border>
     <Border Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="QUELLEN" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Bilder, Videos, Webseiten, Texte, die Uhr und animierte Testbilder liegen im Medienpool. Dateien kannst du direkt hineinziehen. Videos werden bis Full HD in Echtzeit in den Mischer geholt; größere Videos werden verkleinert. Webseiten laufen in einem unsichtbaren Browser und erscheinen wie jede andere Quelle auf beiden Monitoren; sie können in dieser Fassung nicht bedient werden. Downloads, Kamera und Mikrofon sind gesperrt."/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Die Cue-Seite spielt einen geplanten Ablauf wie eine Cue-Liste in QLab. Die Marke steht auf dem nächsten Cue; GO (Leertaste) startet ihn und setzt die Marke sofort weiter. Jeder Cue hat Pre-Wait, Dauer und Post-Wait und kann mit Auto-Continue oder Auto-Follow den nächsten Cue selbst starten. Esc stoppt alle wartenden Cues, Pfeil hoch und runter bewegen die Marke, und jedem Cue lässt sich eine Taste geben, die ihn sofort startet."/>
     </StackPanel></Border>
     <Button Content="Zurück zum Mischer" Click="BackToMixer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="20,9"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <!-- Status bar -->
  <Border Grid.Row="2" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="Bereit." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
   <Button x:Name="UpdateBadge" Grid.Column="1" Visibility="Collapsed" Click="UpdateBadgeClicked" Style="{StaticResource QuietButton}" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="10" MinHeight="0" Padding="10,0" Margin="16,0,0,0" Focusable="False" VerticalAlignment="Stretch"/>
   <TextBlock x:Name="RenderRate" Grid.Column="2" Text="" Style="{StaticResource Mono}" FontSize="10" Margin="20,0,0,0" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="3" Text="STRG + ALT + F10 · NOTAUSSTIEG" Style="{StaticResource Mono}" FontSize="10" Margin="24,0,0,0" VerticalAlignment="Center"/>
  </Grid></Border>

  <!-- Page bar -->
  <Border Grid.Row="3" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <RadioButton x:Name="MixerNav" Tag="mixer" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Checked="NavigationChanged" AutomationProperties.Name="Mischer"><StackPanel><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="MISCHER" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="AuxNav" Tag="aux" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="NavigationChanged" AutomationProperties.Name="AUX-Patcher"><StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="AUX-PATCHER" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="PoolNav" Tag="pool" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="NavigationChanged" AutomationProperties.Name="Medienpool"><StackPanel><TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="MEDIENPOOL" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="CueModeNav" Tag="cues" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="NavigationChanged" AutomationProperties.Name="Cue Mode"><StackPanel><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="CUES" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="SettingsNav" Tag="settings" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="NavigationChanged" AutomationProperties.Name="Einstellungen"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="SETUP" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton>
    <RadioButton x:Name="HelpNav" Tag="help" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="NavigationChanged" AutomationProperties.Name="Hilfe"><StackPanel><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="HILFE" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></RadioButton>
   </StackPanel>
  </Border>
 </Grid>
</Window>
